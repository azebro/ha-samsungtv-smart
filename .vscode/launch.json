{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Home Assistant",
            "type": "debugpy",
            "request": "launch",
            "module": "homeassistant",
            "justMyCode": false,
            "args": [
                "--config",
                "${workspaceFolder}/config"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/custom_components"
            },
            "console": "integratedTerminal",
            "preLaunchTask": "Install Requirements"
        },
        {
            "name": "Run Home Assistant (Debug Logging)",
            "type": "debugpy",
            "request": "launch",
            "module": "homeassistant",
            "justMyCode": false,
            "args": [
                "--config",
                "${workspaceFolder}/config",
                "--debug"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/custom_components"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Debug All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "justMyCode": true,
            "args": [
                "tests/",
                "-v",
                "-o", "addopts=",
                "--no-cov",
                "-x"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug Current Test File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "justMyCode": true,
            "args": [
                "${file}",
                "-v",
                "-o", "addopts=",
                "--no-cov",
                "-x"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug New Feature Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "justMyCode": true,
            "args": [
                "tests/test_brightness_mapping.py",
                "tests/test_number.py",
                "tests/test_switch_guards.py",
                "tests/test_binary_sensor.py",
                "-v",
                "-o", "addopts=",
                "--no-cov",
                "-x"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Attach Local",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ]
        },
        {
            "name": "Python: Attach Remote",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "homeassistant.local",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/usr/src/homeassistant"
                }
            ]
        }
    ]
}
